# institutional Registry - Environment Template
# Duplicate this file to .env and populate with deployment-specific credentials

# Server Configuration
PORT=5001
NODE_ENV=production

# Database Infrastructure
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/lms

# Institutional Identity (JWT)
JWT_SECRET=your_strategic_jwt_secret_key

# Unified Cloud Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Fiscal Gateway (Razorpay) - Managed via Platform Settings (seedDB)
# Note: Key Secret should still be set as an environment fallback or via DB
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Strategic Communication (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="PrismEd LMS" <noreply@yourdomain.com>

# External Authentication (Google)
# server-side ID token verification
GOOGLE_CLIENT_ID=your_google_client_id
# client-side login widget
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Network Infrastructure
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# AI Brain (Gemini)
GEMINI_API_KEY=your_gemini_api_key

# Built-in Live Classroom (LiveKit Cloud)
# You can now configure these directly in Admin Panel > Settings Hub > LiveKit Nexus
# If provided, database settings will take precedence over these environment variables.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Real-time Messaging (Pusher)
# Production contract:
# - Environment variables are the primary source of truth for public deployments.
# - Admin-managed database settings (pusher_*) remain supported as a fallback for managed installs.
# - Only the public app key should ever be exposed to the frontend.
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=your_pusher_cluster
